#!/bin/sh
# Mac and Linux: build, then run the tests CI's linux job lists. On Windows, Forgejo
# runs the whole suite on every master commit before it releases.
set -e
case $(uname -s) in
MINGW*|MSYS*|CYGWIN*) exit 0 ;;
esac
cd "$(dirname "$0")/.."
[ -f Makefile ] || { sh autogen.sh; ./configure --enable-utf8proc; }
make -j4
for t in $(sed -n 's/.*TEST_TMUX="$PWD\/tmux" sh regress\/\([a-z0-9-]*\.sh\).*/\1/p' .forgejo/workflows/ci.yml); do
	echo "== $t"
	TEST_TMUX="$PWD/tmux" sh "regress/$t"
done
